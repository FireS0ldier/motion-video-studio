# Copy to .env (never commit .env). All settings are optional.
# The mvs CLI loads .env automatically.

# Browser used for headless rendering (otherwise auto-detected):
# MVS_BROWSER=/path/to/chrome
# MVS_BROWSER_CHANNEL=chrome        # chrome | msedge | chrome-beta (BROWSER_CHANNEL also works)

# WebGL backend for headless rendering:
#   auto (default) = SwiftShader on Linux (no GPU needed, deterministic), native GPU elsewhere
#   gpu | swiftshader | egl | vulkan | metal
# MVS_GL=auto

# Parallel render workers (default: half the CPU cores, max 4)
# MVS_WORKERS=2

# ffmpeg / ffprobe binaries if they are not on PATH
# MVS_FFMPEG=/usr/local/bin/ffmpeg
# MVS_FFPROBE=/usr/local/bin/ffprobe

# Preview port
# MVS_PORT=5173
